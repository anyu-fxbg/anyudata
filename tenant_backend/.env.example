# ===== 租户版后端配置示例 =====
# 复制为 .env 后填写。所有密钥均在本租户服务器，绝不含天远密钥。

# Django
DEBUG=False
DJANGO_SECRET_KEY=change-me-tenant-edition
ALLOWED_HOSTS=*

# 后台管理员初始密码（init_tenant 使用；上线前务必修改，默认 123456）
ADMIN_PASSWORD=123456

# 数据库（默认 sqlite；取消注释切到 postgres）
# POSTGRES_DB=
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# 白标
TENANT_NAME=我的数据查询服务
TENANT_LOGO_URL=
PRIMARY_COLOR=#6C63FF
PUBLIC_BASE_URL=https://your-domain.com

# 平台 OpenAPI（指向平台，现挂在 XXX.com/saas 下，复用其 HTTPS 证书）
PLATFORM_API_BASE=https://www.XXX.com/saas/api
PLATFORM_API_KEY=在这里填平台发的APIKey
# 本地联调先用 True（返回假报告、不打平台）；上线改成 False
PLATFORM_MOCK=True

# 对客套餐（id 必须与平台 QueryConfig.id 对应；price 为租户定价，单位：分）
PACKAGES_JSON=[{"id":1,"name":"个人标准套餐","price":2200,"desc":"5合1 综合报告（风险/司法/婚姻/车辆/信用分）"}]

# 微信支付 APIv3（租户自己的商户号）
WECHAT_MOCK=True
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_APIV3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_CERT_DIR=/certs
WECHAT_NOTIFY_URL=https://your-domain.com/api/wechat/notify
